      "name": "Bulletin action",
      "kind": "button",
      "description": "Retry and browse actions.",
      "html": "<button class=\"ds-action\" type=\"button\">Browse matches</button>",
      "css": ".ds-action{display:inline-flex;justify-content:center;align-items:center;gap:8px;min-height:44px;padding:10px 16px;border:0;border-radius:6px;background:#00409e;color:#fff;font-family:Inter,'DM Sans',Arial,sans-serif;font-size:14px;font-weight:650;line-height:1.5;cursor:pointer}.ds-action:focus-visible{outline:3px solid #00409e;outline-offset:3px}",
      "refersTo": "action"
    },
    {
      "name": "Back link",
      "kind": "nav",
      "description": "Inline navigation to the parent surface.",
      "html": "<a class=\"ds-back\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7M5 12h14\"/></svg>My Bets</a>",
      "css": ".ds-back{display:inline-flex;align-items:center;gap:8px;min-height:44px;color:#00409e;font-size:13px;font-weight:650;text-decoration:none;font-family:Inter,'DM Sans',Arial,sans-serif;}.ds-back:focus-visible{outline:3px solid #00409e;outline-offset:3px}",
      "refersTo": "back"
    },
    {
      "name": "Stake input",
      "kind": "input",
      "description": "The current decimal entry field; its one-off border is implementation residue.",
      "html": "<input class=\"ds-stake\" type=\"text\" inputmode=\"decimal\" aria-label=\"Stake amount\" placeholder=\"Stake amount\" value=\"1000\"/>",
      "css": ".ds-stake{font-family:Arial,sans-serif;padding:10px;border-radius:8px;width:100%;min-height:48px;font-size:16px;background:#fff;color:#080f32;border:1px solid #75886b;caret-color:#00409e}.ds-stake:focus-visible{outline:3px solid #00409e;outline-offset:3px}"
    },
    {
      "name": "Count tabs",
      "kind": "nav",
      "description": "Unsettled and settled categories with counts and roving tab stops. The application handles ArrowLeft/ArrowRight and Home/End.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"My Bets\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" tabindex=\"0\">Unsettled <span class=\"ds-count\">3</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Settled <span class=\"ds-count\">12</span></button></div>",
      "css": ".ds-tabs{display:flex;gap:24px;border-bottom:1px solid #dce4f2}.ds-tabs button{display:flex;align-items:center;gap:8px;min-height:48px;background:none;border:0;border-bottom:3px solid transparent;color:#536583;padding:8px 0;font-family:Inter,'DM Sans',Arial,sans-serif;font-size:14px;font-weight:650;line-height:1.5;cursor:pointer}.ds-tabs button[aria-selected=true]{border-color:#00409e;color:#00409e}.ds-count{padding:2px 7px;border-radius:4px;background:#eaf0fb;font-size:12px}.ds-tabs button:focus-visible{outline:3px solid #00409e;outline-offset:3px}"
    },
    {
      "name": "Outcome badges",
      "kind": "chip",
      "description": "Translated outcomes with semantic fills.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge\" data-state=\"won\">Won</span><span class=\"ds-badge\" data-state=\"lost\">Lost</span><span class=\"ds-badge\" data-state=\"refunded\">Refunded</span><span class=\"ds-badge\" data-state=\"processing\">Processing</span></div>",
      "css": ".ds-badges{display:flex;gap:8px;flex-wrap:wrap}.ds-badge{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:650;line-height:1.5;padding:5px 8px;border-radius:4px;white-space:normal;font-family:Inter,'DM Sans',Arial,sans-serif;}.ds-badge[data-state=won]{background:#e8f5ec;color:#216e42}.ds-badge[data-state=lost]{background:#fbecee;color:#a43d4a}.ds-badge[data-state=refunded]{background:#eaf0fb;color:#00409e}.ds-badge[data-state=processing]{background:#fbf2dc;color:#805810}",
      "refersTo": "status-won"
