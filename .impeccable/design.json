  "narrative": {
    "northStar": "Matchday Bulletin",
    "overview": "A clear football bulletin built for fast scanning: bold sans headings, light surfaces, blue section markers, thin separators, and aligned figures. Hierarchy comes from type, spacing, and columns. Fixture and bet information stays readable when names, translations, or amounts become longer.\n\nThis record describes the user-approved Matches, match markets and stake entry, My Bets, and bet-detail surfaces on the React website and Kotlin Compose Android app. It does not replace the visual identity of the landing page, account, wallet, referral, VIP, or administration experiences. UCL is the confirmed public name; this surface direction is not a new product slogan. Per-surface composition is recorded in `.impeccable/surfaces/matchday-bulletin.md`.",
    "keyCharacteristics": [
      "Compact information rows with meaningful separators.",
      "Bold sans hierarchy and explicit textual states.",
      "Blue navigation, odds, section rules, and selection emphasis.",
      "Responsive numerical columns and readable local dates.",
      "English and Burmese copy with MMK financial values."
    ],
    "rules": [
      {
        "name": "The Explicit State Rule",
        "body": "Always pair outcome, unavailable, and protected color treatments with their existing translated labels.",
        "section": "colors"
      },
      {
        "name": "The Figure Alignment Rule",
        "body": "Web bulletin pages use tabular numerals. Preserve aligned financial values and the end alignment of fact values; never flatten stake, profit, and returned stake into one unlabeled figure.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep this direction scoped to the four documented betting surfaces.",
      "Do preserve the blue section markers, thin separators, bold sans hierarchy, and labeled numerical columns.",
      "Do allow English and Burmese labels and long team names to wrap without hiding their meaning.",
      "Do keep local kickoff dates, translated state labels, and MMK financial formatting explicit.",
      "Do preserve native light/dark Material roles and web keyboard focus treatment.",
      "Do distinguish refunded stake from profit and potential return."
    ],
    "donts": [
      "Don't infer a new product identity or redesign unrelated surfaces from this scoped record.",
      "Don't use outcome or market protection color as the only state cue.",
      "Don't promote native inherited container colors, serif defaults, or the stake field's one-off border into new bulletin tokens.",
      "Don't claim browser or emulator visual validation until recapture succeeds."
    ]
  }
}
