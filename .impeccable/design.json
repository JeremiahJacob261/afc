    {
      "name": "Bulletin section",
      "kind": "card",
      "description": "Flat bordered section with a blue heading rule.",
      "html": "<section class=\"ds-section\"><h2>Financial breakdown</h2><p>Stake and return are shown separately.</p></section>",
      "css": ".ds-section{background:#fff;border:1px solid #dce4f2;border-radius:12px;padding:24px;color:#080f32;font-family:Inter,'DM Sans',Arial,sans-serif;}.ds-section h2{margin:0 0 20px;padding-bottom:12px;border-bottom:2px solid #00409e;font-size:18px;font-weight:700}.ds-section p{font-size:14px;line-height:1.6;color:#536583}",
      "refersTo": "bulletin-surface"
    },
    {
      "name": "Fixture row",
      "kind": "custom",
      "description": "Compact fixture with local kickoff and three odds previews; sample names only.",
      "html": "<a class=\"ds-fixture\" href=\"#\"><div class=\"ds-meta\"><strong>Football</strong><span>20:00 · Local time</span></div><div class=\"ds-teams\"><span>Home team</span><span>Away team</span></div><div class=\"ds-preview\"><span><small>1–0</small><strong>12%</strong></span><span><small>1–1</small><strong>15%</strong></span><span><small>1–2</small><strong>18%</strong></span></div><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#00409e\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>",
      "css": ".ds-fixture{display:grid;grid-template-columns:minmax(130px,.8fr) minmax(200px,1.2fr) minmax(250px,1fr) 20px;gap:24px;align-items:center;padding:20px 24px;color:#080f32;text-decoration:none;min-height:112px;background:#fff;border:1px solid #dce4f2;transition:background .18s ease-out;font-family:Inter,'DM Sans',Arial,sans-serif;font-variant-numeric:tabular-nums}.ds-meta{display:flex;flex-direction:column;gap:6px;color:#536583;font-size:12px;line-height:1.5}.ds-meta strong{color:#080f32;font-size:13px;font-weight:650}.ds-teams{display:flex;flex-direction:column;gap:10px;font-size:14px;font-weight:650;line-height:1.5}.ds-preview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.ds-preview>span{text-align:center;padding:8px;border-left:1px solid #dce4f2}.ds-preview small{display:block;color:#536583;font-size:12px;margin-bottom:6px}.ds-preview strong{font-size:16px;color:#00409e}.ds-fixture:hover{background:#f4f8ff}.ds-fixture:focus-visible{outline:3px solid #00409e;outline-offset:-3px}@media(max-width:620px){.ds-fixture{grid-template-columns:1fr 20px;gap:16px;padding:20px 16px}.ds-meta{grid-column:1/-1}.ds-preview{grid-column:1/-1}}@media(prefers-reduced-motion:reduce){.ds-fixture{transition:none}}"
    },
    {
      "name": "Score matrix states",
      "kind": "custom",
      "description": "Web available, selected, protected, and disabled cells. Native preserves selection per match ID with primaryContainer, a 2dp primary border, selected semantics, and a Button role.",
      "html": "<div class=\"ds-matrix\"><button class=\"ds-score\" type=\"button\"><span>1–0</span><div><small>Odds</small><strong>12%</strong></div></button><button class=\"ds-score ds-selected\" type=\"button\" aria-pressed=\"true\"><span>1–1</span><div><small>Odds</small><strong>15%</strong></div></button><button class=\"ds-score ds-protected\" type=\"button\"><span>1–2</span><div><small>Company game</small><strong>18%</strong></div></button><button class=\"ds-score\" type=\"button\" disabled><span>2–0</span><div><small>Unavailable</small><strong>—</strong></div></button></div>",
      "css": ".ds-matrix{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:1px solid #dce4f2;border-radius:12px;overflow:hidden}.ds-score{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:80px;padding:16px;border:0;border-right:1px solid #dce4f2;border-bottom:1px solid #dce4f2;background:#fff;color:#080f32;text-align:left;cursor:pointer;transition:background .18s ease-out;font-family:Inter,'DM Sans',Arial,sans-serif;}.ds-score>span{font-size:20px;line-height:1.5;font-weight:700;white-space:nowrap}.ds-score>div{display:flex;flex-direction:column;align-items:flex-end;gap:4px}.ds-score small{color:#536583;font-size:10px;line-height:1.5}.ds-score strong{font-size:16px;color:#00409e;font-weight:700}.ds-score:hover:not(:disabled){background:#f4f8ff}.ds-selected{background:#eaf0fb;box-shadow:inset 0 0 0 2px #00409e}.ds-protected{background:#fff0f7}.ds-protected small{color:#a90059}.ds-score:disabled{background:#f1f4fb;color:#536583;cursor:not-allowed}.ds-score:disabled strong{color:#536583}.ds-score:focus-visible{outline:3px solid #00409e;outline-offset:-3px}@media(prefers-reduced-motion:reduce){.ds-score{transition:none}}",
      "refersTo": "score-cell"
    },
    {
      "name": "Financial facts",
      "kind": "custom",
      "description": "Separate stake, profit, and returned stake; sample refunded record.",
      "html": "<dl class=\"ds-facts\"><div class=\"ds-fact\"><dt>Stake</dt><dd>1,000 MMK</dd></div><div class=\"ds-fact\"><dt>Profit</dt><dd>0 MMK</dd></div><div class=\"ds-fact ds-total\"><dt>Returned stake</dt><dd>1,000 MMK</dd></div></dl>",
      "css": ".ds-facts{margin:0;color:#080f32;font-variant-numeric:tabular-nums;font-family:Inter,'DM Sans',Arial,sans-serif;}.ds-fact{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid #dce4f2}.ds-fact dt{color:#536583;font-size:12px;line-height:1.5}.ds-fact dd{margin:0;font-size:15px;font-weight:650;max-width:65%;text-align:right;overflow-wrap:anywhere}.ds-total{background:#eaf0fb;padding:16px;margin-top:12px;border-radius:6px}.ds-total dt,.ds-total dd{color:#00409e;font-weight:700}",
      "refersTo": "financial-total"
    }
